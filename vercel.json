{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "finance/simple-payment-flow": false
    }
  }
}
